# 前端生产环境变量示例
# 复制为 .env.production 并填写实际值
# 警告：此文件可提交版本库，.env.production 本身不应提交

# 后端 API 根地址（生产环境必填，例如 https://api.example.com）
VITE_API_BASE_URL=https://your-api-domain.com

# 是否启用静态演示模式（使用本地快照数据，无需后端；生产部署通常设 false）
VITE_STATIC_DEMO=false

# 是否启用冻结快照缓存（强制从快照读取，不发起实时请求；生产部署通常设 false）
VITE_FROZEN_SNAPSHOT=false
