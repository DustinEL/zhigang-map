# Spring Boot 运行配置
SPRING_PROFILES_ACTIVE=mysql
SERVER_PORT=8080
DEV_PERMIT_ALL=false
SECURE_COOKIE=false
SPRINGDOC_ENABLED=true
FLYWAY_ENABLED=false
PROFESSIONAL_USERNAME=professional_dev
PROFESSIONAL_PASSWORD=CHANGE_ME
REVIEWER_USERNAME=reviewer_dev
REVIEWER_PASSWORD=CHANGE_ME
PROFESSIONAL_LOGIN_MAX_FAILURES=5
PROFESSIONAL_LOGIN_WINDOW_MINUTES=15
STRUCTURED_JD_MAX_REQUEST_BYTES=31457280

# MySQL：切换 SPRING_PROFILES_ACTIVE=mysql 后生效
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/zhigang_map?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowMultiQueries=true
MYSQL_E2E_URL=jdbc:mysql://127.0.0.1:3306/zhigang_map_e2e?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowMultiQueries=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=CHANGE_ME

# Redis：第一期非必需。只有确认 Redis 服务正在运行后才启用。
ZHIGANG_REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# 明确授权的本地 JD 目录。留空则关闭定时扫描。
ZHIGANG_IMPORT_DIRECTORY=
ZHIGANG_IMPORT_SCAN_DELAY_MS=300000

# 合规在线连接器：仅填写官方/已授权的 HTTPS RSS 或 Atom 地址；留空时完全关闭。
ZHIGANG_RSS_URL=
ZHIGANG_RSS_SOURCE_NAME=
ZHIGANG_RSS_SOURCE_TYPE=RECRUITMENT_JD
ZHIGANG_RSS_LICENSE_STATUS=OPEN
ZHIGANG_RSS_LICENSE_NOTE=
ZHIGANG_RSS_SCAN_DELAY_MS=1800000

# 生成模型提供方：local=免费本地 Qwen（默认），spark=手动使用星火，rules=只用规则。
# 本地模型失败时不会自动调用星火；切换到 spark 会消耗星火额度。
AI_PROVIDER=local
LOCAL_LLM_API_ENDPOINT=http://127.0.0.1:11500/v1/chat/completions
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=qwen-local
LOCAL_LLM_MAX_TOKENS=2048
LOCAL_LLM_CONNECT_TIMEOUT_MS=3000
LOCAL_LLM_READ_TIMEOUT_MS=120000
LOCAL_LLM_RUNTIME_IMAGE=ghcr.nju.edu.cn/ggml-org/llama.cpp@sha256:9aba728bae97dddac5af17a183303dc2f5aa6a52f3e0b098989130ccb674445a
LOCAL_LLM_MODEL_URL=https://modelscope.cn/models/Qwen/Qwen3-4B-GGUF/resolve/master/Qwen3-4B-Q4_K_M.gguf
LOCAL_LLM_MODEL_SHA256=7485fe6f11af29433bc51cab58009521f205840f5b4ae3a32fa7f92e8534fdf5
LOCAL_LLM_CONTEXT_SIZE=8192
LOCAL_LLM_THREADS=10

# 讯飞星火 OpenAI 兼容接口；仅 AI_PROVIDER=spark 时使用。
SPARK_API_ENDPOINT=
SPARK_API_KEY=
SPARK_MODEL=4.0Ultra
SPARK_CONNECT_TIMEOUT_MS=5000
SPARK_READ_TIMEOUT_MS=90000
EMERGING_WORKER_ENDPOINT=http://127.0.0.1:8090
EMERGING_QDRANT_COLLECTION=zhigang_emerging_embeddings
EMERGING_QUERY_QDRANT_COLLECTION=zhigang_emerging_queries
EMERGING_QUERY_CACHE_SIMILARITY=0.93
EMERGING_QUERY_EXISTING_ROLE_SIMILARITY=0.88
EMERGING_QUERY_MIN_EVIDENCE=3
EMERGING_QUERY_MIN_SOURCES=2

# P0-2 可信证据检索：向量接口需兼容 OpenAI /v1/embeddings，模型固定建议 bge-m3。
EMBEDDING_API_ENDPOINT=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_CONNECT_TIMEOUT_MS=3000
EMBEDDING_READ_TIMEOUT_MS=60000
EMERGING_WORKER_CONNECT_TIMEOUT_MS=3000
EMERGING_WORKER_READ_TIMEOUT_MS=120000
RESUME_OCR_ENDPOINT=http://127.0.0.1:8090/v1/resume-ocr
RESUME_OCR_CONNECT_TIMEOUT_MS=3000
RESUME_OCR_READ_TIMEOUT_MS=120000
BGE_M3_RUNTIME_IMAGE=ghcr.nju.edu.cn/ggml-org/llama.cpp@sha256:9aba728bae97dddac5af17a183303dc2f5aa6a52f3e0b098989130ccb674445a
BGE_M3_MODEL_URL=https://modelscope.cn/models/gpustack/bge-m3-GGUF/resolve/master/bge-m3-Q4_K_M.gguf
BGE_M3_MODEL_SHA256=6d39681b26c61279ac1f82db35a04a05009e94c415b51c858ff571489a82fc06
BGE_M3_CONTEXT_SIZE=2048
BGE_M3_UBATCH_SIZE=2048
BGE_M3_THREADS=6
QDRANT_ENDPOINT=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=zhigang_authorized_evidence
CONCLUSION_MIN_COMPANIES=2
CONCLUSION_MIN_SOURCES=1

VITE_API_BASE_URL=
VITE_STATIC_DEMO=false
